{
  "name": "agent-discord-harness",
  "version": "0.1.0",
  "description": "Central orchestrator for self-hosted developer automation via Discord",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:clis": "make build-clis",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean:clis": "make clean"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
